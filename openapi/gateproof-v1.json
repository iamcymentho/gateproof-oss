          },
          "consent": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PackConsent"
              }
            ]
          },
          "home": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PackHome"
              }
            ]
          },
          "check_ins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackCheckIn"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackFile"
            }
          },
          "nipost": {
            "oneOf": [
              {
                "type": "null"
              },
