        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PackCheckIn": {
        "required": [
          "at",
          "latitude",
          "longitude",
          "accuracy_m",
          "distance_to_home_m",
          "same_device_as_first"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "accuracy_m": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "distance_to_home_m": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "same_device_as_first": {
            "type": "boolean"
          }
        }
      },
      "PackConsent": {
        "required": [
          "version",
          "given_at",
          "ip_address",
          "user_agent"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "given_at": {
            "type": "string",
            "format": "date-time"
          },
          "ip_address": {
            "type": [
              "null",
              "string"
            ]
          },
          "user_agent": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PackFile": {
        "required": [
          "id",
          "kind",
          "content_type",
          "size_bytes",
          "sha256",
          "uploaded_at",
          "captured_at",
          "captured_latitude",
          "captured_longitude",
          "captured_distance_to_home_m",
          "deleted_at",
          "download_url"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/EvidenceKind"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
