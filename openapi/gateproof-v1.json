                "$ref": "#/components/schemas/PackNipost"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PackResult"
              }
            ]
          },
          "audit_trail": {
            "type": "array",
            "items": {
