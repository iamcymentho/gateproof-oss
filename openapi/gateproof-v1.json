          },
          "nipost_status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NipostCheckStatus"
              }
            ]
          },
          "nipost_postcode": {
            "type": [
              "null",
              "string"
            ]
          },
          "verdict": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Verdict"
              }
            ]
          },
          "confidence": {
