              "string"
            ],
            "format": "double"
          },
          "captured_distance_to_home_m": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "deleted_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "download_url": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PackHome": {
        "required": [
          "latitude",
          "longitude",
          "accuracy_m",
          "description",
          "captured_at"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
