<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Comments are written where they add meaning; self-explanatory members are left uncommented. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <PackageId>GateProof.Client</PackageId>
    <Version>0.1.0</Version>
    <Description>.NET client for the GateProof proof-of-address API: create verifications, read verdicts and evidence packs, verify webhook signatures.</Description>
    <PackageTags>gateproof;kyc;address-verification;nigeria;nipost;postcode</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
